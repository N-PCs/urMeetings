# ============================================================
# urMeetings — self-hosted env vars 
# Copy to .env.local for dev, and paste into your host's dashboard
# (Vercel / Cloud Run / Fly / Railway / your own box) for prod.
# ============================================================

# --- Supabase (free tier) -----------------------------------
# Create a project at https://supabase.com, then copy from
# Project Settings → API.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Server-side mirrors (same values). Needed by SSR / server functions.
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_PROJECT_ID="your-project-id"
# Only needed if you later add admin/service-role features.
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# --- Google Gemini (free tier via AI Studio) ----------------
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"
# Optional — override the model. Default is gemini-2.5-flash.
# GEMINI_MODEL="gemini-2.5-flash"

# --- Nitro deploy target ------------------------------------
# node-server = Cloud Run / Docker / VPS
# vercel      = Vercel
# cloudflare-pages = Cloudflare Pages
NITRO_PRESET="node-server"

# --- Meeting Baas (real meeting bot) --------------------------
# Sign up at https://meetingbaas.com and grab your API key.
# WEBPAGE_URL is the URL the bot webhook will hit on completion.
MEETING_BAAS_API_KEY="your-meeting-baas-key"
MEETING_BAAS_BASE_URL="https://api.meetingbaas.com"
WEBPAGE_URL="http://localhost:3000"