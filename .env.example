# ============================================================
# urMeetings — self-hosted env vars (no Lovable services)
# Copy to .env.local for dev, and paste into your host's dashboard
# (Vercel / Cloud Run / Fly / Railway / your own box) for prod.
# ============================================================

# --- Supabase (free tier) -----------------------------------
# Create a project at https://supabase.com, then copy from
# Project Settings → API.
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT"

# Server-side mirrors (same values). Needed by SSR / server functions.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_PROJECT_ID="YOUR-PROJECT"
# Only needed if you later add admin/service-role features.
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# --- Google Gemini (free tier via AI Studio) ----------------
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIza..."
# Optional — override the model. Default is gemini-2.5-flash.
# GEMINI_MODEL="gemini-2.5-flash"

# --- Nitro deploy target ------------------------------------
# node-server = Cloud Run / Docker / VPS
# vercel      = Vercel
# cloudflare-pages = Cloudflare Pages
NITRO_PRESET="node-server"